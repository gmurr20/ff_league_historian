# Database Connection
# In Docker/Production (PostgreSQL 16):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ff_historian
# For local offline verification without Docker/Postgres (SQLite fallback):
DATABASE_URL=sqlite:///ff_historian.db

# ESPN Fantasy API Credentials
# Replace with your league ID and private league authentication cookies from espn.com
ESPN_LEAGUE_IDS=12345678
ESPN_LEAGUE_ID=12345678
ESPN_S2=AEC...
ESPN_SWID={12345678-ABCD-1234-ABCD-1234567890AB}

# Backend Service Configuration
FLASK_ENV=development
PORT=5001

# Frontend Service Configuration
VITE_API_BASE_URL=http://localhost:5001
